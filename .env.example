# Database Configuration
# Simple MySQL connection settings
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=runev

# Optional: you can also use a full SQLAlchemy URL instead of the MySQL settings
DATABASE_URL=mysql+pymysql://your_mysql_user:your_mysql_password@localhost:3306/runev

# JWT Secret for Auth
JWT_SECRET=your_jwt_secret_key_here

# Local FastAPI backend used by Streamlit apps
RUNEV_API_BASE_URL=http://127.0.0.1:8000
RUNEV_USER_APP_URL=https://chargewithrunev.streamlit.app

# Razorpay Test Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Real phone OTP delivery with Twilio Verify
PHONE_OTP_PROVIDER=twilio
PHONE_OTP_DEV_MODE=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_VERIFY_CHANNEL=sms

# Email OTP delivery
EMAIL_OTP_PROVIDER=local
EMAIL_OTP_DEV_MODE=true

# Supabase Auth
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key