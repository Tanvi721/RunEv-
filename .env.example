# Database Configuration
# For SQLite (default, easy setup)
DATABASE_URL=sqlite:///./runev.db

# For PostgreSQL (use when deploying to production)
# DATABASE_URL=postgresql://user:password@localhost:5432/runev

# JWT Secret for Auth
JWT_SECRET=super_secret_jwt_key_change_in_production

# Local FastAPI backend used by Streamlit apps
RUNEV_API_BASE_URL=http://127.0.0.1:8000
RUNEV_USER_APP_URL=https://chargewithrunev.streamlit.app

# Supabase Auth
# Enable Google provider in Supabase, then add RUNEV_USER_APP_URL to Auth redirect URLs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Real phone OTP delivery with Twilio Verify
# Create a Verify service in Twilio, then set PHONE_OTP_PROVIDER=twilio.
# Keep PHONE_OTP_PROVIDER=local only for development/testing.
PHONE_OTP_PROVIDER=twilio
DEFAULT_PHONE_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_CHANNEL=sms

# Real email OTP delivery. Use SMTP in production so codes go to the user's inbox
# and are never shown in the app response.
EMAIL_OTP_PROVIDER=smtp
EMAIL_OTP_TTL_SECONDS=300
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tanvibarve21@gmail.com
SMTP_PASSWORD=Tanvibarve@721
SMTP_FROM=runev_login@gmail.com
SMTP_USE_TLS=true

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
